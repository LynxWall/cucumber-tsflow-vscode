{
	"compilerOptions": {
		"esModuleInterop": true,
		"lib": ["es2022"],
		"module": "node16",
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"resolveJsonModule": true,
